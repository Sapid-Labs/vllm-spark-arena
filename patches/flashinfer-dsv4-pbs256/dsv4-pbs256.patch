+# decode never meets. The kernel is generic over page size (it only does
+# idx / pbs and idx % pbs, and the extra-KV section already runs a runtime pbs
+# of 2), so the launcher now instantiates 256 as well.
+_DECODE_DSV4_PAGE_BLOCK_SIZES = frozenset({64, 256})
 
